{
  "name": "@qale/desktop",
  "productName": "Qale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "package": "electron-vite build && electron-builder --dir",
    "icon": "node ../../scripts/make-icon.mjs build/icon-source.png build/icon.png",
    "icon:win": "node ../../scripts/make-ico.mjs build/icon-source.png build/icon.ico",
    "dmg": "electron-vite build && electron-builder --mac",
    "comment:demo": "The demo build (docs/demo-mode.md DM-1). QALE_DEMO=1 is read twice: electron.vite.config.ts bakes it into the binary so the packaged app knows what it is, and electron-builder.demo.yml renames it so it installs beside the real Qale. Plain shell assignment, which is what zsh, bash and the CI runner all use; there is no cross-env in this repo.",
    "dmg:demo": "QALE_DEMO=1 electron-vite build && electron-builder --mac --config electron-builder.demo.yml",
    "package:demo": "QALE_DEMO=1 electron-vite build && electron-builder --dir --config electron-builder.demo.yml",
    "dev:demo": "QALE_DEMO=1 electron-vite dev",
    "win": "electron-vite build && electron-builder --win",
    "win:demo": "cross-env QALE_DEMO=1 electron-vite build && electron-builder --win --config electron-builder.demo.yml",
    "lint": "eslint src scripts",
    "test": "tsx --test --experimental-test-module-mocks --disable-warning=ExperimentalWarning test/*.test.ts",
    "comment:demo-lint": "The lint opens the search index, so it needs better-sqlite3, and that module loads under one ABI only. run-with-sqlite.ts picks the runtime that can load the build this working copy has: plain node after an install, Electron's own node after a packaging or an app run. demo:draft reads and writes JSON only, so it stays on plain tsx.",
    "demo:lint": "tsx scripts/run-with-sqlite.ts scripts/lint-scenarios.ts",
    "demo:draft": "tsx scripts/demo-draft.ts"
  },
  "comment:deps": "electron-builder ships every `dependencies` entry into the asar verbatim. Only main-process deps belong here — the renderer is bundled by vite, so anything it imports (react, tiptap, lucide, ai) is already inside out/renderer and goes in devDependencies. Putting a renderer-only package here ships it twice and cost us ~45 MB.",
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@qale/agent": "workspace:*",
    "@qale/application": "workspace:*",
    "@qale/atlassian": "workspace:*",
    "@qale/connectors": "workspace:*",
    "@qale/domain": "workspace:*",
    "@qale/ipc": "workspace:*",
    "@qale/markdown": "workspace:*",
    "@qale/sessions": "workspace:*",
    "@qale/vault": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "posthog-node": "^5.47.3",
    "simple-git": "^3.36.0",
    "turndown": "^7.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.23",
    "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@floating-ui/dom": "^1.8.0",
    "@qale/eslint-config": "workspace:*",
    "@qale/typescript-config": "workspace:*",
    "@qale/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.2",
    "@tiptap/core": "^3.27.4",
    "@tiptap/extension-drag-handle": "^3.27.4",
    "@tiptap/extension-list": "^3.27.4",
    "@tiptap/extension-table": "^3.27.4",
    "@tiptap/extensions": "^3.27.4",
    "@tiptap/markdown": "^3.27.4",
    "@tiptap/pm": "^3.27.4",
    "@tiptap/react": "^3.27.4",
    "@tiptap/starter-kit": "^3.27.4",
    "@tiptap/suggestion": "^3.27.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "~5.1.4",
    "ai": "^7.0.22",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.20.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typebox": "1.3.7",
    "typescript": "~5.9.2",
    "use-stick-to-bottom": "^1.1.6",
    "vite": "^7.3.0"
  }
}

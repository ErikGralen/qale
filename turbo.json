{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "ANTHROPIC_API_KEY",
    "QALE_GOOGLE_CLIENT_ID",
    "QALE_GOOGLE_CLIENT_SECRET",
    "QALE_POSTHOG_KEY",
    "QALE_POSTHOG_HOST",
    "QALE_POSTHOG_DEV"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", "dist/**"]
    },
    "desktop#package": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^topo"]
    },
    "check-types": {
      "dependsOn": ["^topo"]
    },
    "topo": {
      "dependsOn": ["^topo"]
    },
    "test": {
      "dependsOn": ["^topo"]
    }
  }
}
